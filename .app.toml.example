port="8080"
mode="dev"
url="http://localhost:8080"
key="key_must_length_32"

[server]
# 0s preserves net/http's unlimited default. Set a positive duration to opt in.
readHeaderTimeout="0s"
readTimeout="0s"
writeTimeout="0s"
idleTimeout="0s"
shutdownTimeout="5s"

[logger]
level="info"

[storage]
path="/path/to/uploads"

[db]
username="username"
password="password"
database="db_name"
host="localhost"
port="3306"
tls=false

[db.table]
prefix=""

[redis]
host="127.0.0.1"
username=""
password=""
port="6379"
db=0
prefix="app"
pingTimeout="3s"
dialTimeout="3s"
readTimeout="3s"
writeTimeout="3s"
poolTimeout="4s"
poolSize=0
minIdleConnections=2
maxIdleConnections=0
connectionMaxIdleTime="5m"
connectionMaxLifetime="30m"

[redis.tls]
enabled=false
serverName=""

[queue]
prefix="test"
topics=["default"]
shutdownTimeout="5s"
streamMaxLength=100000
# Approximate retention: size for worst-case lag because trimming can evict old pending entries.
maxRetries=3
retryInitialInterval="250ms"
retryMaxInterval="2s"
deadLetterSuffix="dead-letter"
deadLetterMaxLength=10000

[queue.consumer]
name="default"
group="default"
# Increase only when jobs are independent and do not require strict ordering.
concurrency=1
nackResendInterval="1s"
blockTime="1s"
claimInterval="30s"
claimBatchSize=100
# Must exceed the longest expected job execution, including in-process retries.
maxIdleTime="5m"
checkConsumersInterval="1m"
consumerTimeout="5m"

[oauth]
key="oauth_app_id_or_key"
secret="oauth_app_secret"
api="https://www.example.com"
publicKeyPath="/path/to/oauth-public.key"

[auth.api]
secret="32-chars-length"
audience="name of this api"
issuers=[ "allowed name of issuer" ]

[ui]
assetMode="embedded"
viteDevOrigin="http://127.0.0.1:5173"

[configcenter]
enabled=false
username=""
password=""

[configload]
enabled=false

# Targets are loaded and merged in declaration order. Later targets override
# matching values from earlier targets. Each target selects its own source.
[[configload.targets]]
source="database"
namespace="shared"
environment="base"

[[configload.targets]]
source="http"
namespace="my-service"
environment="production"

[configload.targets.http]
baseURL="https://primary-config.example.com"
apiKeyEnv="PRIMARY_CONFIG_API_KEY"
timeout="5s"

[[configload.targets]]
source="http"
namespace="regional-service"
environment="production"

[configload.targets.http]
baseURL="https://regional-config.example.com"
apiKeyEnv="REGIONAL_CONFIG_API_KEY"
timeout="8s"

[configcrypt]
enabled=false
provider="file"
activeKey="config-key-v1"
keyring="/absolute/path/to/config-center-keys.json"
